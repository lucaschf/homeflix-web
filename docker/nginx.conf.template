# Rendered at start: ${HOMEFLIX_API} is the backend's URL (see the Dockerfile).
# Only that variable is substituted; nginx's own $variables are left as they are.

# Behind a TLS proxy (Caddy) the browser's scheme arrives in X-Forwarded-Proto:
# pass it on as is, and only fall back to this hop's scheme when there is none.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Avatars are capped at 20 MB by the backend.
    client_max_body_size 25m;

    # This container's own health, independent of the backend's.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API, HLS and progressive streams included. Streams must not be
    # buffered (the player reads them as they come) and can run for hours.
    location /api/ {
        proxy_pass ${HOMEFLIX_API};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /health {
        proxy_pass ${HOMEFLIX_API};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Vite's hashed bundles never change under the same name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes: anything that is not a file is the app.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
